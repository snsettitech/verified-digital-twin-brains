# ============================================================================
# PersonaOn AI — Staging Environment Configuration
# ============================================================================
# Copy this file to .env.staging and fill in your values.
# This is used by the ADK migration staging environment.
# ============================================================================

# ---------- Environment ----------
ENVIRONMENT=staging
DEV_MODE=false

# ---------- Agent Runtime ----------
# "adk" = new ADK pipeline, "langgraph" = legacy LangGraph pipeline
AGENT_RUNTIME=adk

# ---------- Supabase (STAGING project — DO NOT use production) ----------
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_KEY=eyJ...your-staging-anon-key
SUPABASE_SERVICE_KEY=eyJ...your-staging-service-key
JWT_SECRET=your-staging-jwt-secret

# ---------- Pinecone ----------
# Can share production index (read-only) or use a staging index
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name
PINECONE_INDEX_MODE=vector

# ---------- LLM Providers ----------
# Same API keys work for staging (API calls are stateless)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
CEREBRAS_API_KEY=csk-...
GOOGLE_API_KEY=AI...

# ---------- Inference Routing ----------
INFERENCE_PROVIDER=openai
INFERENCE_ROUTING_MODE=auto
INFERENCE_FALLBACK_ENABLED=true
INFERENCE_PROVIDER_TIMEOUT_SECONDS=25

# ---------- Feature Flags ----------
ENABLE_REALTIME_INGESTION=true
ENABLE_ENHANCED_INGESTION=false
ENABLE_DELPHI_RETRIEVAL=true
ENABLE_WEB_SEARCH=false
DEEP_RESEARCH_ENABLED=false
NAME_ONLY_DEEP_RESEARCH_ENABLED=true
GRAPH_MEMORY_ENABLED=false
DEEPAGENTS_ENABLED=false
CONVERSATIONAL_REALIZER_ENABLED=true
QUERY_REWRITING_ENABLED=true

# ---------- Grounding ----------
ADAPTIVE_GROUNDING_POLICY_ENABLED=true
ADAPTIVE_GROUNDING_HIGH_SCORE=0.82
GROUNDING_VERIFIER_ENABLED=true
GROUNDING_MIN_SUPPORT_RATIO=0.78

# ---------- Reranking ----------
# At least one reranker must be available
COHERE_API_KEY=your-cohere-key
# Or use FlashRank (local, no key needed)

# ---------- Observability ----------
# Optional — Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Redis (optional) ----------
REDIS_URL=

# ---------- Frontend ----------
# Set in Vercel preview deployment environment
# NEXT_PUBLIC_API_URL=https://staging-api.personaon.ai

# ---------- Server ----------
PORT=8000
HOST=0.0.0.0

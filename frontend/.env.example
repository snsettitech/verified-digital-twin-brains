# Copy to `frontend/.env.local` for local frontend development.

# Supabase (required for auth/session handling in proxy.ts and callback route)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend URL for redirects/share links
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional frontend debug toggles
NEXT_PUBLIC_SHOW_ENV_BADGE=true
NEXT_PUBLIC_E2E_BYPASS_AUTH=0

# Feature flags (optional — all default to true if unset)
# NEXT_PUBLIC_FF_DASHBOARD_CHAT=true
# NEXT_PUBLIC_FF_MEMORY_CENTER=true
# NEXT_PUBLIC_FF_PRIVACY_CONTROLS=true
# NEXT_PUBLIC_FF_PUBLISH_CONTROLS=true
# NEXT_PUBLIC_FF_CONTEXT_PANEL=true
# NEXT_PUBLIC_FF_SOURCE_LABELING=true
# NEXT_PUBLIC_FF_OFFICE_HOURS_MODE=true

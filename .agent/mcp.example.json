{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_URL": "https://your-project.supabase.co",
        "SUPABASE_SERVICE_ROLE_KEY": "your-supabase-service-role-key"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fs@latest"
      ],
      "env": {
        "ALLOWED_DIRECTORIES": "/path/to/your/repo"
      }
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git@latest",
        "d:/verified-digital-twin-brains"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "your-github-pat"
      }
    },
    "grep": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-grep@latest"
      ],
      "env": {
        "SEARCH_ROOT": "/path/to/your/repo"
      }
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "@vercel/mcp-server@latest"
      ],
      "env": {
        "VERCEL_TOKEN": "your-vercel-token",
        "VERCEL_PROJECT_ID": "your-vercel-project-id"
      }
    },
    "render": {
      "command": "npx",
      "args": [
        "-y",
        "@render/mcp-server@latest"
      ],
      "env": {
        "RENDER_API_KEY": "your-render-api-key",
        "RENDER_SERVICE_ID": "your-render-service-id"
      }
    },
    "openapi": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-openapi@latest"
      ],
      "env": {
        "OPENAPI_SPEC_PATH": "/path/to/your/repo/backend/openapi.json",
        "OPENAPI_BASE_URL": "http://localhost:8000"
      }
    },
    "graphiti": {
      "url": "http://127.0.0.1:8001/mcp/"
    },
    "zep": {
      "url": "https://docs-mcp.getzep.com/mcp"
    }
  }
}
# =============================================================================
# VERIFIED DIGITAL TWIN BRAINS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# =============================================================================

# =============================================================================
# REQUIRED: Core Application
# =============================================================================

# OpenAI API (Required for AI features)
OPENAI_API_KEY=sk-your-openai-key-here

# Supabase (Required for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ACCESS_TOKEN=sbp-your-access-token-here

# Pinecone (Required for vector search)
PINECONE_API_KEY=pcsk-your-pinecone-key-here
PINECONE_HOST=your-index-host-here
PINECONE_INDEX_NAME=your-index-name

# JWT (Required for authentication)
JWT_SECRET=your-jwt-secret-min-32-chars-long

# =============================================================================
# REQUIRED: Deployment and CORS
# =============================================================================

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://your-frontend-url.vercel.app

# Allowed origins (comma-separated for CORS)
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app,http://localhost:3000

# =============================================================================
# OPTIONAL: Feature Flags
# =============================================================================

# Enable realtime ingestion
ENABLE_REALTIME_INGESTION=true

# Enable enhanced ingestion features
ENABLE_ENHANCED_INGESTION=false

# Enable Delphi retrieval
ENABLE_DELPHI_RETRIEVAL=true

# Enable VC routes
ENABLE_VC_ROUTES=false

# Development mode
DEV_MODE=false

# =============================================================================
# OPTIONAL: External Services
# =============================================================================

# Cohere (for reranking)
COHERE_API_KEY=your-cohere-key-here

# Cerebras (for fast inference)
CEREBRAS_API_KEY=your-cerebras-key-here

# ElevenLabs (for voice)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Google AI
GOOGLE_API_KEY=your-google-key-here

# Langfuse (for observability)
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_RELEASE=v1.0.0

# Neo4j/Graphiti (for memory)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Redis (for queue)
REDIS_URL=redis://localhost:6379/0

# Firecrawl (for web scraping)
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Exa (for search)
EXA_API_KEY=your-exa-key-here

# Dumpling API
DUMPLING_API_KEY=your-dumpling-key-here

# =============================================================================
# OPTIONAL: Testing and Development
# =============================================================================

# Test account credentials (for automated testing)
TEST_ACCOUNT_EMAIL=test@example.com
TEST_ACCOUNT_PASSWORD=test-password

# Deployed URLs (for integration testing)
DEPLOYED_FRONTEND_URL=https://your-frontend-url.vercel.app/dashboard/simulator
DEPLOYED_BACKEND_URL=https://your-backend-url.onrender.com

# Graph RAG
GRAPH_RAG_ENABLED=true

# Content extraction
CONTENT_EXTRACT_MAX_CHUNKS=6

# Owner memory
AUTO_APPROVE_OWNER_MEMORY=true

# Pinecone configuration
PINECONE_INDEX_MODE=integrated
PINECONE_TEXT_FIELD=text

# =============================================================================
# NOTES
# =============================================================================
# - Never commit actual secrets to version control
# - Use strong, unique values for JWT_SECRET in production
# - Rotate API keys regularly
# - Use environment-specific .env files (.env.local, .env.production)
# - In production, prefer secret management services over .env files

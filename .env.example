# Verified Digital Twin Brains
# Copy to `.env` for local backend + worker development.
# Frontend public vars live in `frontend/.env.example`.

# ---------------------------------------------------------------------------
# Required backend bootstrap
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Optional compatibility fallback used by some scripts/routes.
SUPABASE_KEY=
PINECONE_API_KEY=pcsk-your-pinecone-key
PINECONE_INDEX_NAME=your-pinecone-index
PINECONE_INDEX_MODE=integrated
PINECONE_TEXT_FIELD=chunk_text
JWT_SECRET=your-supabase-jwt-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional but common for local worker/runtime
# ---------------------------------------------------------------------------
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
HF_API_TOKEN=
HUGGINGFACEHUB_API_TOKEN=
EMBEDDING_PROVIDER=openai
INFERENCE_PROVIDER=openai
OPENAI_MODEL=gpt-4o
OPENAI_JSON_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CONVERSATIONAL_REALIZER_ENABLED=false
QUERY_REWRITE_ENABLED=true
QUERY_REWRITING_ENABLED=true
RUNTIME_CONFIDENCE_GATE_ENABLED=false
YOUTUBE_ASR_PROVIDER=openai

# ---------------------------------------------------------------------------
# Deep research / external providers
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=exa
EXA_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_DEEP_RESEARCH_MODEL=o3
NAME_ONLY_DEEP_RESEARCH_ENABLED=true
DR_PHASE_12_SUPPRESS_UNRESOLVED=true
DR_PHASE_12_AUTO_PUBLISH=false

# ---------------------------------------------------------------------------
# Graph / memory features
# ---------------------------------------------------------------------------
GRAPH_MEMORY_ENABLED=false
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
AUTO_APPROVE_OWNER_MEMORY=true
RETRIEVAL_HYDE_ENABLED=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_RELEASE=local-dev

# ---------------------------------------------------------------------------
# Optional ingestion and search helpers
# ---------------------------------------------------------------------------
COHERE_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
DUMPLING_API_KEY=
YOUTUBE_COOKIES_FILE=

# ---------------------------------------------------------------------------
# Local testing helpers
# ---------------------------------------------------------------------------
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
TEST_TWIN_ID=
TEST_SOURCE_ID=
TEST_ACCESS_TOKEN=
TEST_BACKEND_URL=http://localhost:8000
